# ============================================================
# 开发环境配置模板
# ============================================================
# 使用方法（在本目录下执行）：
#   Windows:      copy application-dev.yml.example application-dev.yml
#   Linux/macOS:  cp application-dev.yml.example application-dev.yml
# 然后把下面的 your-xxx 占位符替换成自己的真实配置。
#
# 注意：application-dev.yml 已在 .gitignore 中忽略，不会进入版本库，
#      请勿把填好真实值的文件提交上去。
# ============================================================

sky:
  jwt:
    # JWT 签名密钥，不少于 32 字节的随机字符串，管理端与用户端分别设置
    admin-secret-key: pjj-please-change-this-to-a-32byte-random-string
    user-secret-key: pjj-please-change-this-to-another-32byte-string

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: sky_take_out
    username: root
    password: your-mysql-password

  alioss:
    endpoint: oss-cn-beijing.aliyuncs.com
    access-key-id: your-oss-access-key-id
    access-key-secret: your-oss-access-key-secret
    bucket-name: your-bucket-name

  redis:
    host: localhost
    port: 6379
    password: your-redis-password
    database: 10

  wechat:
    # 微信公众平台/开放平台的应用 ID
    appid: your-wechat-appid
    # 应用 AppSecret，用于获取 access_token
    secret: your-wechat-secret
    # 微信支付商户号
    mchid: your-mchid
    # 商户 API 证书序列号
    mchSerialNo: your-mch-serial-no
    # 微信支付 V3 API 密钥，用于解密回调通知中的敏感信息
    apiV3Key: your-api-v3-key
    # 商户私钥文件路径（pem），仅在本地测试回调时需要
    # privateKeyFilePath: /path/to/apiclient_key.pem
    # 微信支付平台证书文件路径（pem）
    # weChatPayCertFilePath: /path/to/wechatpay_cert.pem
    # 支付成功回调地址
    notifyUrl: http://localhost/notify/paySuccess
    # 退款成功回调地址
    refundNotifyUrl: http://localhost/notify/refundSuccess

  shop:
    address: your-shop-address

  baidu:
    ak: your-baidu-map-ak
